<!doctype html>
<html lang="es">

<head>
	<meta charset="UTF-8">
	<meta name="viewport"
		content="width=device-width, initial-scale=1.0">

	<title>Hola Mundo</title>

	<link rel="stylesheet"
		href="/publicos/css/main.css">
</head>

<body>
	<header>
		<h1>Hola</h1>

		<h4>
			Este es un ejemplo de CRUD hecho con Express, MongoDB y AJAX
			<small>y mucho amor (¡y ahora con ia!)</small>
		</h4>
	</header>

	<main>
		<div class="acciones">
			<button id="formulario"
				type="button">
				Crear
			</button>

			<button id="mostrar"
				type="button">
				Recargar
			</button>
		</div>

		<form id="crear"
			class="hide">
			<label for="usuario">Nuevo usuario</label>

			<input id="usuario"
				type="text"
				name="usuario"
				placeholder="Nombre"
				required>

			<button type="submit">
				Guardar
			</button>
		</form>

		<div id="usuarios">
			<% if
				(usuarios.length===0)
				{
				%>
				<p>No hay usuarios</p>
				<% }
					else
					{
					%>
					<% usuarios.forEach(usuario=> { %>
						<div class="usuario"
							id="usuario-<%= usuario._id %>">
							<div>
								<strong class="id">
									<%= usuario._id
										%>
								</strong>
							</div>

							<div>
								<input type="text"
									class="nombre"
									value="<%= usuario.nombre %>">
							</div>

							<button type="button"
								class="idEliminar"
								data-id="<%= usuario._id %>">
								Eliminar
							</button>

							<button type="button"
								class="idActualizar"
								data-id="<%= usuario._id %>">
								Actualizar
							</button>
						</div>
						<% })
							%>
							<% }
								%>
		</div>

		<template id="nuevoUsuarioTemplate">
			<div class="usuario">
				<div>
					<strong class="id"></strong>
				</div>

				<div>
					<input type="text"
						class="nombre">
				</div>

				<button type="button"
					class="idEliminar">
					Eliminar
				</button>

				<button type="button"
					class="idActualizar">
					Actualizar
				</button>
			</div>
		</template>
	</main>

	<script src="/publicos/js/main.js"></script>
</body>

</html>